# ================================================================
# 필수
# ================================================================
GEMINI_API_KEY=YOUR_KEY

# 사용할 Gemini 모델명
GEMINI_MODEL=gemini-3.1-flash-lite

# 임베딩 실행 장치: cpu / cuda(NVIDIA GPU) / mps(Apple Silicon Mac)
EMBEDDING_DEVICE=cpu

# Chroma DB 저장 경로 (상대/절대 경로)
CHROMA_DB_PATH=./chroma_db

# ================================================================
# 선택 (비워두면 기본값으로 동작)
# ================================================================

# 단계별 모델 추론(thinking) 수준. 낮을수록 빠름. 비우면 모델 기본값.
# 모델이 지원하지 않으면 자동으로 설정 없이 호출함.
# - 질문 이해: 오타 교정·후속 질문 완성 등 단순 변환이라 low 권장
# - 판단+답변: 근거 자료 선택(환각 방지 핵심)이라 모델 기본값 권장
GEMINI_THINKING_UNDERSTAND=low
GEMINI_THINKING_ANSWER=

# Gemini 과부하(503) 등으로 재시도까지 실패했을 때 쓸 보조 모델명. 비우면 사용 안 함.
GEMINI_FALLBACK_MODEL=